{
  "name": "everything-claude-code",
  "version": "2.1.0",
  "description": "Continuous Learning v2 — instinct-based learning system for OpenCode. Observes tool usage, extracts behavioral patterns as atomic \"instincts\", and evolves them into skills/commands/agents.",
  "type": "module",
  "main": ".opencode/dist/plugins/index.js",
  "exports": {
    ".": {
      "import": ".opencode/dist/plugins/index.js"
    },
    "./plugins": {
      "import": ".opencode/dist/plugins/index.js"
    }
  },
  "files": [
    ".opencode/dist",
    ".opencode/commands",
    ".opencode/opencode.json",
    "skills",
    "scripts",
    "hooks"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "continuous-learning",
    "instinct",
    "claude-code"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
